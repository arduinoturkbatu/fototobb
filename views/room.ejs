<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Stream</title>
    <script>
        const ROOM_ID = "<%= roomId %>"
    </script>
    <script src="https://unpkg.com/peerjs@1.2.0/dist/peerjs.min.js" defer></script>
    <script src="/socket.io/socket.io.js" defer></script>
    <script src="script.js" defer></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background: #1a1a1a;
            color: white;
            margin: 0;
            overflow: hidden;
        }
        
        #role-display {
            position:fixed;
            font-size: 24px;
            margin-bottom: 20px;
            padding: 5px;
            border-radius: 5px;
        }
        
        .streamer {
            background: #28a745;
        }
        
        .viewer {
            background: #007bff;
        }

        #video-grid {
            height: 100dvh;
            aspect-ratio: 16/9;
        }

        video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
            background: #000;
        }
    </style>
</head>
<body>
    <div id="role-display">Connecting...</div>
    <div id="video-grid"></div>
</body>
</html>