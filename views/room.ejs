<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Stream</title>
    <script>
        window.ENV = {
            FIREBASE_API_KEY: "<%= firebaseApiKey %>",
            FIREBASE_AUTH_DOMAIN: "<%= firebaseAuthDomain %>",
            FIREBASE_PROJECT_ID: "<%= firebaseProjectId %>",
            FIREBASE_STORAGE_BUCKET: "<%= firebaseStorageBucket %>",
            FIREBASE_MESSAGING_SENDER_ID: "<%= firebaseMessagingSenderId %>",
            FIREBASE_APP_ID: "<%= firebaseAppId %>",
            FIREBASE_DATABASE_URL: "<%= firebaseDatabaseURL %>"
        };

        const ROOM_ID = "<%= roomId %>"
    </script>
    <script src="https://unpkg.com/peerjs@1.2.0/dist/peerjs.min.js" defer></script>
    <script src="/socket.io/socket.io.js" defer></script>
    <script src="script.js" type="module" defer></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');

        body {
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            text-align: center;
            background: #1a1a1a;
            color: white;
            padding: 1rem;
            overflow: hidden;
            width: 100dvw;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            user-select: none;
        }

        #options {
            width: calc(100% - 2rem);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        
        #role-display {
            width: 100%;
            font-size: 1.5rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            display: flex;
            text-align: center;
            justify-content: center;
            align-items: center;
            border-radius: 0.5rem;
            height: min-content;
        }

        #viewer-options {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 0.5rem;
        }

        #viewer-options > div {
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            width: 100%;
        }

        #viewer-options > div > span {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            flex-direction: row;
            gap: 0.2rem;
        }

        #streamer-options {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 0.5rem;
        }

        #streamer-options input {
            padding: 0.5rem 1rem;
            background: rgb(255 255 255 / 0.2);
            border: 1px solid rgb(255 255 255 / 0.1);
            border-radius: 1rem;
            outline: none;
            color: #fff;
        }

        #streamer-options p {
            margin: 0;
            padding: 0;
        }

        #streamer-options div {
            width: 70%;
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 1rem;
            border: 1px solid rgb(255 255 255 / 0.1);
            border-radius: 1rem;
            transition: 0.2s all;
        }

        button {
            background: rgb(255 255 255 / 0.1);
            outline: none;
            border: none;
            border-radius: 999rem;
            color: #fff;
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            gap: 0.5rem;
            padding: 1rem;
            width: auto;
            font-size: 1rem;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            transition: 0.2s all;
            position: relative;
        }

        button:hover {
            opacity: 0.9;
            scale: 0.9;
        }

        button .badge {
            position: absolute;
            bottom: -0.5rem;
            background: #0055ff;
            font-size: 0.8rem;
            padding: 0.2rem 0.4rem;
            border-radius: 2rem;
        }

        svg {
            width: 1.5rem;
            height: 1.5rem;
        }
        
        .streamer {
            background: #28a745;
        }
        
        .viewer {
            border: 2px solid rgb(255 255 255 / 0.1);
        }

        #video-grid {
            width: calc(100% - 2rem);
            height: min-content;
            position: relative;
        }

        #video-grid #unscreen {
            position: absolute;
            bottom: 1rem;
            right: 1rem;
        }

        #video-grid #unscreen svg {
            width: 1.5rem;
            height: 1.5rem;
            color: #fff;
        }

        video {
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: contain;
            border-radius: 0.7rem;
            background: #000;
        }

        @media (min-width: 600px) {
            body {
                flex-direction: row !important;
            }

            #video-grid {
                width: 50% !important;
            }

            #options {
                width: 50% !important;
            }
        }
    </style>
</head>
<body>
    <div id="video-grid"></div>
    <div id="options">
        <div id="role-display">Bağlanıyor...</div>
        <div id="viewer-options">
            <div>
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                        class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                    <span id="viewers"></span>
                </span>
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                        class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span id="time"></span>
                </span>
            </div>
            <div>
                <button onclick="history.back()">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                        class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
                    </svg>
                </button>
                <button id="fullscreenBtn">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                        class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                    </svg>
                    Tam Ekran
                </button>
                <button onclick="location.reload();">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                        class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>

                </button>
            </div>
            <div>
                <button id="addHeart">
                    ❤️
                    <span class="badge" id="heart"></span>
                </button>
                <button id="addApplause">
                    👏
                    <span class="badge" id="applause"></span>
                </button>
                <button id="addConffetti">
                    🎉
                    <span class="badge" id="conffetti"></span>
                </button>
                <button id="addFunny">
                    😂
                    <span class="badge" id="funny"></span>
                </button>
                <button id="addShocked">
                    😦
                    <span class="badge" id="shocked"></span>
                </button>
                <button id="addThink">
                    🤔
                    <span class="badge" id="think"></span>
                </button>
            </div>
            <br/>
            <sub>Not: Yayın durmuş gözüküyorsa ekrana dokunmayı deneyebilirsiniz.</sub>
        </div>
        <div id="streamer-options">
            <input type="text" name="name" id="name" placeholder="Yayın ismini oluşturun." />
            <button id="startStream">Yayını başlat</button>
        </div>
    </div>
</body>
</html>
